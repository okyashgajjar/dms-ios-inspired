// ==================================================
// General
// ==================================================

config-notification {
    disable-failed
}

prefer-no-csd

// ==================================================
// Input
// ==================================================

input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// ==================================================
// Outputs (Monitors)
// ==================================================

// Configure your monitors here (example):
// output "eDP-1" {
//     mode "1920x1080@60"
//     position x=0 y=0
//     focus-at-startup
// }

// ==================================================
// Layout & Visuals
// ==================================================
//spawn-at-startup "/home/dipankar/.config/niri/wallpaper-cycler.sh"

// ==================================================
// Layout & Visuals
// ==================================================

layout {
    gaps 2
    center-focused-column "on-overflow"
    background-color "transparent"
    always-center-single-column
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.3
        proportion 0.5
        proportion 0.7
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.34
        proportion 0.5
        proportion 0.67
        proportion 1.0
    }


    focus-ring {
        width 0
        inactive-color "#505050"
        active-gradient from="#6ea1f2" to="#89b4fa" angle=45
    }

    struts {
        left 1
        right 1
        top 1
        bottom 1
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 4
        width 3
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 10
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
    }

    shadow {
        off
    }
}


overview {
    workspace-shadow {
        off
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    QT_QPA_PLATFORM "wayland;xcb"
    TERMINAL "foot"
    // Keep browsers and Electron apps on native Wayland (no Xwayland overhead)
    MOZ_ENABLE_WAYLAND "1"
    MOZ_WEBRENDER "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    SDL_VIDEODRIVER "wayland"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.9 stiffness=400 epsilon=0.0001
    }

    window-open {
        duration-ms 100
        curve "ease-out-quad"
    }

    window-close {
        duration-ms 80
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=350 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.85 stiffness=300 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.9 stiffness=350 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=700 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 120
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }
}

