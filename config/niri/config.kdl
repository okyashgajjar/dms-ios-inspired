// ==================================================
// Recent Windows
// ==================================================

recent-windows {
    debounce-ms 500
    open-delay-ms 100

    highlight {
        active-color "#8aadf4ff"
        urgent-color "#ed8796ff"
        padding 8
        corner-radius 4
    }

    previews {
        max-height 500
        max-scale 0.5
    }
    binds {
        Alt+Tab         { next-window     scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
    }
}


// ==================================================
// fixed workspaces
// ==================================================

workspace "1"
workspace "2"

// ==================================================
// Keybinds
// ==================================================

//included in dms/binds.kdl

// ==================================================
// Blur
// ==================================================


// ==================================================
// External Includes
// ==================================================

//include "dms/colors.kdl"
//include "dms/layout.kdl"
//include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/windowrules.kdl"
include "dms/cursor.kdl"
include "dms/outputs.kdl"

// ==================================================
// Personal overrides (after DMS includes, so they win)
// ==================================================

binds {
    // Control Center toggle (iOS style)
    Mod+C { spawn "dms" "ipc" "call" "control-center" "toggle"; }

    // Use foot instead of kitty (lower RAM)
    Mod+Return { spawn "foot"; }

    // Switch focus between windows/columns (works across all apps)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
}

// Performance optimizations for low-spec hardware
// debug {
//     // Machine-specific: set if needed for your GPU
//     // render-drm-device "/dev/dri/card0"
// }
