window-rule {
    match app-id="btrfs-assistant"
    open-floating true
    default-column-width { proportion 0.35; }
    default-window-height { fixed 500; }
}

window-rule {
    match app-id="org.quickshell"
    //open-floating true
    // default-column-width { }
    //default-window-height { fixed 750; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="brave-browser"
    default-column-width { proportion 0.7; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
    
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.7; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="kitty"
    // default-column-width { proportion 0.5; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="zed"
    default-column-width { proportion 0.7; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="spotify"
    default-column-width { proportion 0.7; }
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

window-rule {
    geometry-corner-radius 10 //20
    clip-to-geometry true
    opacity 1.0
    draw-border-with-background false
    popups {
        opacity 1.0
    }
}

